{
  "name": "amc10-predictor",
  "productName": "AMC 10 Predictor",
  "version": "0.2.0",
  "description": "Forecast your AMC 10 score from the papers you have sat",
  "author": "Lily",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.everett6.amc10predictor",
    "artifactName": "AMC10-Predictor-${version}-${os}-${arch}.${ext}",
    "publish": null,
    "files": [
      "main.js"
    ],
    "extraResources": [
      {
        "from": "../dist-backend/amc10-backend",
        "to": "backend"
      },
      {
        "from": "../frontend/dist",
        "to": "frontend-dist"
      },
      {
        "from": "../data/raw/live",
        "to": "seed",
        "filter": [
          "*.json"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "buildResources": "build"
    }
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "desktopName": "amc10-predictor.desktop"
}
